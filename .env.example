# ThermoTrace Unified Environment Variables
# Copy to .env for local overrides

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
PORT=8000

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://thermotrace:thermotrace_pass@localhost:5432/thermotrace_db

# PostGIS Credentials
POSTGRES_USER=thermotrace
POSTGRES_PASSWORD=thermotrace_pass
POSTGRES_DB=thermotrace_db
POSTGRES_PORT=5432

# Map Configuration
# MapLibre GL JS uses open carto/OSM tiles by default; API key is optional for custom tile providers
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# FIRMS API (Optional - Offline cached data is used by default)
FIRMS_MAP_KEY=
